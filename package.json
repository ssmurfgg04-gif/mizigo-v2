{
  "name": "mizigo",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "build:netlify": "node scripts/db-prepare.mjs && node scripts/patch_netlify_cache.mjs && next build",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "postinstall": "node scripts/db-prepare.mjs",
    "lint": "eslint .",
    "lint:copy": "node scripts/lint-copy.mjs",
    "test": "vitest run",
    "db:push": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:prepare": "node scripts/db-prepare.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-toast": "^1.2.14",
    "@sentry/nextjs": "^11.4.0",
    "@tanstack/react-query": "^5.82.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "maplibre-gl": "^6.12.0",
    "next": "^16.1.1",
    "prisma": "^6.11.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.3",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "z-ai-web-dev-sdk": "^0.0.18",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.16.1",
    "@tailwindcss/postcss": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "libsodium-wrappers": "^0.8.4",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}